{
  "name": "@gracefulinfra/relay-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "lint:openapi": "spectral lint --fail-severity=warn openapi/*.yaml",
    "lint:format": "prettier --check .",
    "lint": "pnpm lint:openapi && pnpm lint:format",
    "test": "node scripts/validate-fixtures.mjs && node scripts/test-spectral-rules.mjs && node scripts/cost-model.mjs --check",
    "bundle": "node scripts/bundle-openapi.mjs openapi/relay.v0.yaml gen/openapi/relay.v0.json",
    "format": "prettier --write .",
    "cost-model": "node scripts/cost-model.mjs"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.16.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.9.9",
    "yaml": "2.9.1"
  }
}
